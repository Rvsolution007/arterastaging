APP_NAME=Artera
APP_ENV=local
MCP_ANALYTICS_ADMIN_EMAILS=arterapixel7@gmail.com
MCP_ANALYTICS_TOKEN_NAME=mcp-analytics
MCP_ANALYTICS_MAX_DATE_RANGE_DAYS=366
MCP_ANALYTICS_MAX_PAGE_SIZE=50
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE="Asia/Kolkata"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arterastaging
# Optional explicit database name for local Apache setups that host multiple apps.
ARTERA_DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

# Internal API route prefix key (this acts as a URL prefix, not a secret, but keep unique)
API_KEY=your_api_route_prefix

# Shared AdLive identity bridge. Keep the secret server-side only.
ADLIVE_SSO_SHARED_SECRET=
# Exact AdLive browser callback URL(s), comma-separated per environment.
ADLIVE_WEB_REDIRECT_URIS=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=artera_session

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# Use an app password, NOT your real account password
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your_email@gmail.com"
MAIL_FROM_NAME="Artera"

# AWS (optional — for S3 file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher / WebSockets
PUSHER_APP_ID=local_app_id
PUSHER_APP_KEY=local_app_key
PUSHER_APP_SECRET=local_app_secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Provider Configuration
# Set AI_PROVIDER to "vertex" (uses Google Service Account) or "gemini" (uses API key)
AI_PROVIDER=vertex
AI_MODEL=gemini-2.5-pro
GEMINI_MODEL=gemini-1.5-flash-latest
CHATGPT_MODEL=gpt-4o-mini

# Google Cloud / Vertex AI (required if AI_PROVIDER=vertex)
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
VERTEX_LOCATION=us-central1

# RunPod Serverless AI (for image & video generation)
# Get your API key from https://runpod.io
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_FLUX_ENDPOINT_ID=your_flux_endpoint_id
RUNPOD_WAN_ENDPOINT_ID=your_wan_endpoint_id

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=/auth/google/callback

# Google Play Android Publisher API (service account must have Play Console access)
GOOGLE_PLAY_PACKAGE_NAME=com.arterapixel.pro
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Analytics & Webmaster
# Google Analytics Measurement ID (safe to expose publicly)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GTM_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Background Removal Service URL (Docker internal / microservice)
BG_REMOVER_URL=http://localhost:8000

# Artera Admin Analytics MCP
NODE_ENV=production
PORT=3001
MCP_TRANSPORT=http
MCP_PATH=/mcp
LOG_LEVEL=info

# Protect the MCP endpoint. Use a 32+ character value from a password manager.
# For a public ChatGPT app, put an OAuth/OIDC identity-aware gateway in front of
# this service and restrict it to arterapixel7@gmail.com as well.
MCP_AUTH_MODE=bearer
MCP_ACCESS_TOKEN=replace-with-a-long-random-mcp-access-token

# Existing Artera Laravel application. Include its configured API prefix in
# this URL. Do not put the private prefix in source code, README, or chat.
# Example shape: https://arterapixel.com/<private-api-prefix>
ARTERA_API_BASE_URL=https://arterapixel.com/replace-with-private-api-prefix
ARTERA_API_TOKEN=replace-with-output-of-php-artisan-artera-mcp-issue-token
ARTERA_API_TIMEOUT_MS=15000
ARTERA_API_MAX_RETRIES=2
ARTERA_API_RETRY_BASE_DELAY_MS=250

# GA4 Artera Pixel property from the supplied Analytics screenshots.
# The property ID is not a secret. The service account needs Viewer permission
# on this property and Google Analytics Data API must be enabled.
GA4_PROPERTY_ID=455458344
# Prefer setting GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/artera-ga4.json
# in deployment. This optional value is useful only when a secret manager
# injects the complete escaped JSON safely; do not commit a key file or paste it into chat.
GA4_SERVICE_ACCOUNT_JSON=

# Data minimisation. No ticket body, raw activity payload, IP address, device
# ID, password, token, payment ID, or secret is returned by the Laravel API.
ARTERA_MASK_PII=true
ARTERA_INCLUDE_FREE_TEXT=false
ARTERA_MAX_RESPONSE_RECORDS=50
ARTERA_MAX_RESPONSE_DEPTH=6
ARTERA_CACHE_MAX_ENTRIES=500
ARTERA_CACHE_DEFAULT_TTL_SECONDS=60

# Optional relative-path overrides for non-production or versioned APIs.
ARTERA_ENDPOINT_OVERVIEW=/admin/mcp/overview
ARTERA_ENDPOINT_INSTALLS=/admin/mcp/installs
ARTERA_ENDPOINT_SALES=/admin/mcp/sales
ARTERA_ENDPOINT_ADS=/admin/mcp/ads
ARTERA_ENDPOINT_TICKETS=/admin/mcp/tickets
ARTERA_ENDPOINT_TEMPLATES=/admin/mcp/templates
ARTERA_ENDPOINT_REVIEWS=/admin/mcp/reviews
ARTERA_ENDPOINT_USER_SEARCH=/admin/mcp/users/search
ARTERA_ENDPOINT_USER_DETAILS=/admin/mcp/users/:id
ARTERA_ENDPOINT_USER_ACTIVITY=/admin/mcp/users/:id/activity
